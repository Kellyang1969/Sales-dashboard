# Copy this file to .env for local development (.env is git-ignored).
# On Vercel, add the same two names under Project Settings → Environment Variables.

# Your Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The PUBLISHABLE key (sb_publishable_...) or legacy anon key. Never the service_role / secret key:
# anything starting with VITE_ is bundled into the public JavaScript.
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
